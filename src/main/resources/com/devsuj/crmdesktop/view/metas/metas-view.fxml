<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Metas y rendimiento: arriba las metas del mes elegido, abajo el rendimiento de cada vendedor.
     SplitPane vertical: el usuario reparte el alto entre las dos tablas. -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.devsuj.crmdesktop.view.metas.MetasController"
      spacing="16" styleClass="pantalla">

    <Label text="Metas y rendimiento" styleClass="title-2"/>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Periodo:"/>
        <ComboBox fx:id="filtroMes" prefWidth="140"/>
        <ComboBox fx:id="filtroAnio" prefWidth="100"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox fx:id="accionesGestion" spacing="8" alignment="CENTER_LEFT">
            <Button text="Nueva meta" onAction="#onNueva" styleClass="accent">
                <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
                <tooltip><Tooltip text="Asignar la meta mensual de un vendedor"/></tooltip>
            </Button>
            <Button fx:id="botonEditar" text="Editar" onAction="#onEditar">
                <graphic><FontIcon iconLiteral="fth-edit-2"/></graphic>
                <tooltip><Tooltip text="Editar la meta seleccionada (doble clic en la fila)"/></tooltip>
            </Button>
            <Button fx:id="botonEliminar" text="Eliminar" onAction="#onEliminar" styleClass="danger">
                <graphic><FontIcon iconLiteral="fth-trash-2"/></graphic>
                <tooltip><Tooltip text="Eliminar la meta seleccionada"/></tooltip>
            </Button>
        </HBox>
        <Button onAction="#onRecargar" styleClass="button-icon">
            <graphic><FontIcon iconLiteral="fth-refresh-cw"/></graphic>
            <tooltip><Tooltip text="Recargar"/></tooltip>
        </Button>
    </HBox>

    <SplitPane orientation="VERTICAL" dividerPositions="0.5" VBox.vgrow="ALWAYS">
        <VBox spacing="8">
            <StackPane VBox.vgrow="ALWAYS">
                <TableView fx:id="tabla">
                    <columns>
                        <TableColumn fx:id="colVendedor" text="Vendedor" minWidth="140"/>
                        <TableColumn fx:id="colPeriodo" text="Periodo" minWidth="110"/>
                        <TableColumn fx:id="colObjetivo" text="Objetivo" minWidth="100"/>
                        <TableColumn fx:id="colVendido" text="Vendido" minWidth="100"/>
                        <TableColumn fx:id="colVentas" text="Ventas" minWidth="60"/>
                        <TableColumn fx:id="colAvance" text="Avance" minWidth="170"/>
                        <TableColumn fx:id="colFaltante" text="Faltante" minWidth="100"/>
                    </columns>
                </TableView>
                <VBox fx:id="capaCarga" alignment="CENTER" styleClass="capa-carga">
                    <ProgressIndicator/>
                </VBox>
            </StackPane>
            <HBox spacing="8" alignment="CENTER_RIGHT">
                <Label fx:id="etiquetaPaginacion" styleClass="text-muted"/>
                <Button fx:id="botonAnterior" styleClass="button-icon">
                    <graphic><FontIcon iconLiteral="fth-chevron-left"/></graphic>
                    <tooltip><Tooltip text="Página anterior"/></tooltip>
                </Button>
                <Button fx:id="botonSiguiente" styleClass="button-icon">
                    <graphic><FontIcon iconLiteral="fth-chevron-right"/></graphic>
                    <tooltip><Tooltip text="Página siguiente"/></tooltip>
                </Button>
            </HBox>
        </VBox>
        <VBox spacing="8">
            <Label fx:id="tituloRendimiento" styleClass="title-4"/>
            <StackPane VBox.vgrow="ALWAYS">
                <TableView fx:id="tablaRendimiento">
                    <columns>
                        <TableColumn fx:id="colRVendedor" text="Vendedor" minWidth="140"/>
                        <TableColumn fx:id="colRVentas" text="Ventas" minWidth="60"/>
                        <TableColumn fx:id="colRTotal" text="Total vendido" minWidth="110"/>
                        <TableColumn fx:id="colRMeta" text="Meta" minWidth="100"/>
                        <TableColumn fx:id="colRAvance" text="Avance" minWidth="170"/>
                        <TableColumn fx:id="colRGanadas" text="Ganadas" minWidth="70"/>
                        <TableColumn fx:id="colRPerdidas" text="Perdidas" minWidth="70"/>
                        <TableColumn fx:id="colRConversion" text="Conversión" minWidth="90"/>
                    </columns>
                </TableView>
                <VBox fx:id="capaCargaRendimiento" alignment="CENTER" styleClass="capa-carga">
                    <ProgressIndicator/>
                </VBox>
            </StackPane>
        </VBox>
    </SplitPane>
</VBox>
