<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.CustomTextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Usuarios y equipos. Las acciones de la derecha solo las ve un ADMIN. -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.devsuj.crmdesktop.view.usuarios.UsuariosController"
      spacing="16" styleClass="pantalla">

    <Label text="Usuarios y equipos" styleClass="title-2"/>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <CustomTextField fx:id="campoBusqueda" promptText="Buscar por nombre o email (Ctrl+F)"
                         HBox.hgrow="ALWAYS" maxWidth="360">
            <left><FontIcon iconLiteral="fth-search"/></left>
        </CustomTextField>
        <ComboBox fx:id="filtroRol" prefWidth="160"/>
        <ComboBox fx:id="filtroActivo" prefWidth="170"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="avisoSoloLectura" text="Solo un administrador puede modificar usuarios." styleClass="text-muted"/>
        <HBox fx:id="accionesAdmin" spacing="8" alignment="CENTER_LEFT">
            <Button text="Nuevo" onAction="#onNuevo" styleClass="accent">
                <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
                <tooltip><Tooltip text="Dar de alta un usuario (Ctrl+N)"/></tooltip>
            </Button>
            <Button fx:id="botonEditar" text="Editar" onAction="#onEditar">
                <graphic><FontIcon iconLiteral="fth-edit-2"/></graphic>
                <tooltip><Tooltip text="Editar nombre, email, rol y gerente (doble clic en la fila)"/></tooltip>
            </Button>
            <Button fx:id="botonEstado" onAction="#onCambiarEstado">
                <graphic><FontIcon iconLiteral="fth-power"/></graphic>
                <tooltip><Tooltip text="Activar o desactivar el usuario seleccionado"/></tooltip>
            </Button>
            <Button fx:id="botonPassword" onAction="#onCambiarPassword" styleClass="button-icon">
                <graphic><FontIcon iconLiteral="fth-key"/></graphic>
                <tooltip><Tooltip text="Cambiar la contraseña del usuario seleccionado"/></tooltip>
            </Button>
        </HBox>
        <Button onAction="#onRecargar" styleClass="button-icon">
            <graphic><FontIcon iconLiteral="fth-refresh-cw"/></graphic>
            <tooltip><Tooltip text="Recargar (F5)"/></tooltip>
        </Button>
    </HBox>

    <StackPane VBox.vgrow="ALWAYS">
        <TableView fx:id="tabla">
            <columns>
                <TableColumn fx:id="colNombre" text="Nombre" minWidth="150"/>
                <TableColumn fx:id="colEmail" text="Email" minWidth="200"/>
                <TableColumn fx:id="colRol" text="Rol" minWidth="110"/>
                <TableColumn fx:id="colGerente" text="Gerente" minWidth="130"/>
                <TableColumn fx:id="colEstado" text="Estado" minWidth="80"/>
                <TableColumn fx:id="colAlta" text="Alta" minWidth="120"/>
            </columns>
        </TableView>
        <VBox fx:id="capaCarga" alignment="CENTER" styleClass="capa-carga">
            <ProgressIndicator/>
        </VBox>
    </StackPane>

    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Label fx:id="etiquetaPaginacion" styleClass="text-muted"/>
        <Button fx:id="botonAnterior" styleClass="button-icon">
            <graphic><FontIcon iconLiteral="fth-chevron-left"/></graphic>
            <tooltip><Tooltip text="Página anterior"/></tooltip>
        </Button>
        <Button fx:id="botonSiguiente" styleClass="button-icon">
            <graphic><FontIcon iconLiteral="fth-chevron-right"/></graphic>
            <tooltip><Tooltip text="Página siguiente"/></tooltip>
        </Button>
    </HBox>
</VBox>
