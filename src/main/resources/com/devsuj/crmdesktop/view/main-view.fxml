<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Ventana principal. El StackPane pone dos capas una encima de otra:
     1) BorderPane: barra superior + menú lateral + área de contenido (se adapta al tamaño de la ventana).
     2) capa-notificaciones: donde util.Notificaciones apila los avisos, abajo a la derecha. -->
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.devsuj.crmdesktop.view.MainController">
    <BorderPane>

        <top>
            <HBox styleClass="barra-superior" alignment="CENTER_LEFT" spacing="12">
                <FontIcon iconLiteral="fth-bar-chart-2" iconSize="22"/>
                <Label text="CRM de Ventas" styleClass="title-3"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="apiUrlLabel" styleClass="text-muted"/>
                <ToggleButton fx:id="botonTema" styleClass="button-icon, flat"/>
                <!-- Usuario actual: su nombre y rol; desde aquí se cambia la contraseña o se cierra sesión. -->
                <MenuButton fx:id="menuUsuario" styleClass="flat">
                    <items>
                        <MenuItem text="Cambiar mi contraseña" onAction="#onCambiarPassword">
                            <graphic><FontIcon iconLiteral="fth-key"/></graphic>
                        </MenuItem>
                        <SeparatorMenuItem/>
                        <MenuItem text="Cerrar sesión" onAction="#onCerrarSesion" accelerator="Shortcut+Shift+Q">
                            <graphic><FontIcon iconLiteral="fth-log-out"/></graphic>
                        </MenuItem>
                    </items>
                </MenuButton>
            </HBox>
        </top>

        <!-- Los botones de cada módulo se agregan desde MainController. -->
        <left>
            <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="edge-to-edge">
                <VBox fx:id="menu" styleClass="menu-lateral" spacing="4">
                    <Label text="MÓDULOS" styleClass="text-caption, text-muted"/>
                </VBox>
            </ScrollPane>
        </left>

        <!-- Aquí el Navegador coloca la pantalla del módulo elegido. -->
        <center>
            <StackPane fx:id="contenido"/>
        </center>
    </BorderPane>

    <!-- pickOnBounds="false": los clics en la parte vacía de la capa llegan a la pantalla de abajo. -->
    <VBox styleClass="capa-notificaciones" alignment="BOTTOM_RIGHT" spacing="8" pickOnBounds="false"/>
</StackPane>
