<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Tablero de KPIs. ScrollPane: en pantallas bajas se desplaza. Las tarjetas están en un TilePane
     (se acomodan en más o menos columnas según el ancho) y las gráficas en una rejilla 50 % / 50 %. -->
<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.devsuj.crmdesktop.view.tablero.TableroController"
            fitToWidth="true" styleClass="edge-to-edge">
    <VBox spacing="16" styleClass="pantalla">
        <Label text="Tablero" styleClass="title-2"/>
        <Label fx:id="saludo" styleClass="text-muted"/>

        <FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT">
            <Label text="Periodo:"/>
            <DatePicker fx:id="filtroDesde" promptText="Desde" prefWidth="130"/>
            <DatePicker fx:id="filtroHasta" promptText="Hasta" prefWidth="130"/>
            <Button text="Mes actual" onAction="#onMesActual" styleClass="flat"/>
            <Button text="Año actual" onAction="#onAnioActual" styleClass="flat"/>
            <Button onAction="#onActualizar" styleClass="button-icon">
                <graphic><FontIcon iconLiteral="fth-refresh-cw"/></graphic>
                <tooltip><Tooltip text="Actualizar el tablero"/></tooltip>
            </Button>
            <ProgressIndicator fx:id="indicadorCarga" prefWidth="22" prefHeight="22"/>
        </FlowPane>
        <Label fx:id="mensajeError" styleClass="mensaje-general" wrapText="true" maxWidth="Infinity"/>

        <TilePane fx:id="tarjetas" hgap="12" vgap="12" prefColumns="3" prefTileWidth="280"/>

        <GridPane hgap="16" vgap="16">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>
            <BarChart fx:id="graficaMeses" title="Ventas por mes" minHeight="280" prefHeight="300"
                      GridPane.columnIndex="0" GridPane.rowIndex="0">
                <xAxis><CategoryAxis label="Mes"/></xAxis>
                <yAxis><NumberAxis fx:id="ejeMeses"/></yAxis>
            </BarChart>
            <BarChart fx:id="graficaPipeline" title="Pipeline actual por etapa" minHeight="280" prefHeight="300"
                      GridPane.columnIndex="1" GridPane.rowIndex="0">
                <xAxis><CategoryAxis label="Etapa"/></xAxis>
                <yAxis><NumberAxis fx:id="ejePipeline"/></yAxis>
            </BarChart>
            <BarChart fx:id="graficaVendedores" title="Ventas por vendedor (periodo)" minHeight="280" prefHeight="300"
                      GridPane.columnIndex="0" GridPane.rowIndex="1">
                <xAxis><CategoryAxis label="Vendedor"/></xAxis>
                <yAxis><NumberAxis fx:id="ejeVendedores"/></yAxis>
            </BarChart>
            <PieChart fx:id="graficaCategorias" title="Ventas por categoría (periodo)" minHeight="280" prefHeight="300"
                      labelsVisible="true" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        </GridPane>

        <Label text="Productos más vendidos (periodo)" styleClass="title-4"/>
        <ListView fx:id="masVendidos" prefHeight="160"/>

        <!-- Soporte y fidelización: situación actual (no dependen del periodo elegido). -->
        <GridPane hgap="16" vgap="16">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>
            <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="Soporte" styleClass="title-4"/>
                <TilePane fx:id="soporteTarjetas" hgap="10" vgap="10" prefTileWidth="200"/>
                <BarChart fx:id="graficaPrioridad" title="Tickets pendientes por prioridad" minHeight="220" prefHeight="240">
                    <xAxis><CategoryAxis label="Prioridad"/></xAxis>
                    <yAxis><NumberAxis fx:id="ejePrioridad"/></yAxis>
                </BarChart>
            </VBox>
            <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label text="Fidelización" styleClass="title-4"/>
                <TilePane fx:id="fidelizacionTarjetas" hgap="10" vgap="10" prefTileWidth="200"/>
                <Label text="Clientes con más puntos" styleClass="text-muted"/>
                <ListView fx:id="topClientes" prefHeight="190"/>
            </VBox>
        </GridPane>

        <!-- Solo GERENTE y ADMIN: el controlador oculta esta sección al VENDEDOR. -->
        <VBox fx:id="seccionCampanas" spacing="10">
            <Label text="Efectividad de campañas" styleClass="title-4"/>
            <TableView fx:id="tablaCampanas" prefHeight="220">
                <columns>
                    <TableColumn fx:id="colCampana" text="Campaña" minWidth="180"/>
                    <TableColumn fx:id="colCampanaEstado" text="Estado" minWidth="100"/>
                    <TableColumn fx:id="colDestinatarios" text="Destinatarios" minWidth="100"/>
                    <TableColumn fx:id="colApertura" text="Apertura" minWidth="90"/>
                    <TableColumn fx:id="colRespuesta" text="Respuesta" minWidth="90"/>
                    <TableColumn fx:id="colCosto" text="Costo por respuesta" minWidth="130"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</ScrollPane>
